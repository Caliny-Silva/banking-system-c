#include <stdio.h>

int main() {

    float saldo = 500;
    float deposito;
    float saque;
    int opcao = 0;

    while (opcao != 4) {

        printf("\n===== BANCO DIGITAL =====\n");
        printf("1 - Consultar saldo\n");
        printf("2 - Realizar deposito\n");
        printf("3 - Realizar saque\n");
        printf("4 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {

            case 1:
                printf("\nSaldo atual: R$ %.2f\n", saldo);
                break;

            case 2:
                printf("\nDigite o valor do deposito: R$ ");
                scanf("%f", &deposito);

                if (deposito >= 1) {
                    saldo = saldo + deposito;
                    printf("Deposito realizado com sucesso!\n");
                    printf("Novo saldo: R$ %.2f\n", saldo);
                } else {
                    printf("Valor invalido!\n");
                }
                break;

            case 3:
                printf("\nDigite o valor do saque: R$ ");
                scanf("%f", &saque);

                if (saque > 0 && saque <= saldo) {
                    saldo = saldo - saque;
                    printf("Saque realizado com sucesso!\n");
                    printf("Novo saldo: R$ %.2f\n", saldo);
                } else {
                    printf("Valor invalido ou saldo insuficiente!\n");
                }
                break;

            case 4:
                printf("\nObrigado por utilizar o Banco Digital!\n");
                break;

            default:
                printf("\nOpcao invalida! Tente novamente.\n");
        }
    }

    return 0;
}
